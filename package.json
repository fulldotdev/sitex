{
  "name": "sitex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp run check:source && vp run build && vp run check:build",
    "dev": "vp run docs#dev",
    "build": "vp run -r build",
    "check:build": "vp run docs#check:build",
    "check:source": "vp check && vp run @fulldotdev/sitex#check",
    "fix:source": "vp check --fix",
    "preview": "vp run docs#preview",
    "changeset": "changeset",
    "release": "changeset version && pnpm install --lockfile-only && vp fmt",
    "release:publish": "vp run @fulldotdev/sitex#build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "http-server": "catalog:",
    "vite-plus": "^0.2.3"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "pnpm@12.11.2"
}
